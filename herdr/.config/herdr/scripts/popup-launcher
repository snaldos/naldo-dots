#!/bin/sh

menu() {
  prompt=$1
  shift

  printf '%s\n' "$@" |
    fzf \
      --prompt="$prompt" \
      --layout=reverse \
      --border \
      --no-multi
}

show_message() {
  clear
  printf '\n%s\n\n' "$1"
  printf 'Press Enter to return...'
  IFS= read -r _ </dev/tty
}

enter_git_root() {
  root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    show_message "The current directory is not inside a Git repository."
    return 1
  }

  cd "$root" || {
    show_message "Could not enter the Git repository root."
    return 1
  }
}

git_menu() {
  while :; do
    git_choice=$(menu "Git tool: " \
      "Lazygit" \
      "TUICR" \
      "GitHub dashboard" \
      "Back") || return

    case "$git_choice" in
    "Lazygit")
      enter_git_root || continue
      exec lazygit
      ;;

    "TUICR")
      enter_git_root || continue
      exec tuicr
      ;;

    "GitHub dashboard")
      exec gh dash
      ;;

    "Back")
      return
      ;;
    esac
  done
}

while :; do
  choice=$(menu "Open popup: " \
    "Git tools" \
    "Yazi" \
    "Typst scratchpad" \
    "Terminal") || exit 0

  case "$choice" in
  "Git tools")
    git_menu
    ;;

  "Yazi")
    exec yazi
    ;;

  "Typst scratchpad")
    exec hx /tmp/helix-scratchpad.typ
    ;;

  "Terminal")
    exec "${SHELL:-sh}"
    ;;
  esac
done
